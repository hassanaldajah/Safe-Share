# Copy this file to ".env" and fill it in. ".env" is ignored by git: never commit it.

# ---------- Required ----------
# Signs the login tokens. Generate one with:  openssl rand -base64 32
JWT_SECRET=

# ---------- E-mail (sends the OTP verification codes) ----------
# A Gmail address plus an App Password:
# Google Account > Security > 2-Step Verification > App passwords
MAIL_USERNAME=
MAIL_PASSWORD=

# Local demo without any e-mail account: print the OTP codes in the API log instead.
# docker compose logs -f api
# NEVER set this to true on a public server.
DEV_LOG_OTP=false

# ---------- Optional ----------
# Google Gemini key for the in-app AI assistant
GCP_API_KEY=

# Database login (change the password if the database port is ever exposed)
DB_USERNAME=safeshare_user
DB_PASSWORD=safeshare_password

# Where encrypted files are kept: "local" (on this machine, default) or "s3" (Amazon S3)
STORAGE_TYPE=local

# Public address of the web app. Change both lines if it is not on localhost.
FRONTEND_URL=http://localhost:5173
# Browser origins allowed to call the API, comma separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Amazon S3: only needed for STORAGE_TYPE=s3, profile pictures and backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
AWS_S3_BUCKET_FILES=
